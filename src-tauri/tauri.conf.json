{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meditor",
  "version": "0.1.2",
  "identifier": "com.enacimie.meditor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "meditor",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5000 http://localhost:5000 https://texlive2.swiftlatex.com; img-src 'self' asset: data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' asset: data:; script-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "desktopTemplate": "meditor.desktop" },
      "rpm": { "desktopTemplate": "meditor.desktop" }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
